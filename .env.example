# SiliconFlow / Volces 大模型 API 环境变量示例模板
# VITE variables are exposed to the client-side bundle.
# Do NOT store your API Keys here for production.
# You can enter a default testing API Key below for local dev.

VITE_DEEPSEEK_API_KEY=your_testing_api_key_here
VITE_DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
VITE_DEEPSEEK_MODEL=Qwen/Qwen2.5-7B-Instruct
